+void BaseRealSenseNode::appendMountTransformMsg(
+    std::vector<geometry_msgs::msg::TransformStamped>& static_tf_msgs,
+    const rclcpp::Time& t) const
+{
+    if (!_publish_mount_tf)
+        return;
+
+    geometry_msgs::msg::TransformStamped msg;
+    msg.header.stamp = t;
+    msg.header.frame_id = (static_cast<std::ostringstream&&>(
+        std::ostringstream() << _tf_prefix << _mount_parent_frame_id)).str();
+    msg.child_frame_id = BASE_FRAME_ID;
+    msg.transform.translation.x = _mount_x;
+    msg.transform.translation.y = _mount_y;
+    msg.transform.translation.z = _mount_z;
+
+    tf2::Quaternion q;
+    q.setRPY(_mount_roll, _mount_pitch, _mount_yaw);
+    q.normalize();
+    msg.transform.rotation.x = q.x();
+    msg.transform.rotation.y = q.y();
+    msg.transform.rotation.z = q.z();
+    msg.transform.rotation.w = q.w();
+
+    static_tf_msgs.push_back(msg);
+}
